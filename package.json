{
  "name": "deskpal-chibi-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5192 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4192",
    "sync:assets": "node scripts/sync-chibi-assets.mjs",
    "sync:upstream": "node scripts/sync-upstream.mjs",
    "notify:feishu": "node scripts/notify-feishu.mjs",
    "package:release": "node scripts/package-release.mjs",
    "apply:deskpal": "node scripts/apply-to-deskpal.mjs",
    "restore:deskpal": "node scripts/apply-to-deskpal.mjs --restore",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "preact": "^10.27.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
